PORT=8080
NODE_ENV=development

# MongoDB Connection URIs
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=social
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<test-database>?retryWrites=true&w=majority&appName=social

# MongoDB Individual Parameters (Fallback)
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
MONGO_DEFAULT_DATABASE=social
MONGO_TEST_DATABASE=test-social

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
